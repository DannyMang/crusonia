{
  "name": "crusonia",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "cf-typegen": "wrangler types --include-env=false",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "migrate": "bun scripts/migrate.ts",
    "setup": "bun scripts/setup.ts",
    "secrets": "wrangler secret bulk .dev.vars"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@neondatabase/serverless": "^1.2.0",
    "agentmail": "^0.5.53",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "bun-types": "^1.4.4",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  }
}

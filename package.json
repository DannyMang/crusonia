{
  "name": "crusonia",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "cd web && bun run dev",
    "dev:web:mock": "cd web && bun run dev:mock",
    "build:web": "cd web && bun run build",
    "deploy": "bun run build:web && wrangler deploy",
    "deploy:preview": "bun run build:web && wrangler versions upload --preview-alias app",
    "deploy:dry": "bun run build:web && wrangler deploy --dry-run",
    "cf-typegen": "wrangler types --include-env=false",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "bun test",
    "migrate": "bun scripts/migrate.ts",
    "setup": "bun scripts/setup.ts",
    "secrets": "wrangler secret bulk .dev.vars"
  },
  "dependencies": {
    "@clerk/backend": "3.26.2",
    "@hono/mcp": "^0.3.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@neon/config": "^1.13.0",
    "@neon/env": "^2.1.0",
    "@neondatabase/serverless": "^1.2.0",
    "agentmail": "^0.5.53",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "bun-types": "^1.4.4",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  }
}

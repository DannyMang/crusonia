# Crusonia iMessage bridge settings. deploy/aws.sh writes them to the box (mode 600) from your local files.
# Locally: cp .env.example .env, fill in, then `bun --env-file=.env src/index.ts`.

# live = Photon Spectrum (Stable); mock = in-memory iMessage for local runs (POST /mock/inbound, signed).
SPECTRUM_MODE=live

# Photon dashboard (app.photon.codes) > your Stable project > Settings: project ID and secret.
# The bridge is the only place these live: the Worker never sees them.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# The owner's phone in E.164 (+14155550123): the only number the bridge texts and the only sender it obeys.
# On Free/Pro Photon plans the shared line only messages registered users: add this number under Users.
OWNER_PHONE=
# Optional: other handles of the owner (comma list), e.g. the Apple ID email their iPhone sends from.
# OWNER_ALIASES=

# Shared with the Worker's BRIDGE_SECRET. Generate once: openssl rand -hex 32
BRIDGE_SECRET=

# The Worker's public URL (wrangler.jsonc PUBLIC_URL). The bridge polls <WORKER_URL>/webhooks/photon/poll for notices
# and posts owner tapbacks to <WORKER_URL>/webhooks/photon. It accepts no inbound connections.
WORKER_URL=https://crusonia.dev

# Local health server (loopback only), poll interval, log level. Defaults shown.
# PORT=8080
# HEALTH_HOST=127.0.0.1
# POLL_INTERVAL_MS=5000
# LOG_LEVEL=info

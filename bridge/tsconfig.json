{
  // The bridge runs on Bun (Dockerfile). The code sticks to node:* APIs and erasable TypeScript, so it also runs
  // on Node 22+ with type stripping if gRPC ever needs it.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024"],
    "types": ["bun-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src", "test", "deploy"]
}

# Cloudflare Workers static assets: headers for files served from web/dist (not for the Worker's responses).
# Vite's build output has a content hash in every file name, so it never changes in place.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Landing media keep their names across deploys: cache for a day.
/media/*
  Cache-Control: public, max-age=86400

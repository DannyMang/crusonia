# Crusonia secrets. Copy to .dev.vars (gitignored), fill in, then upload to the Worker:
#   cp .dev.vars.example .dev.vars
#   bun run secrets            # = wrangler secret bulk .dev.vars
# Never commit .dev.vars, paste values into chat, or pass them as CLI arguments.
# Leave a line empty if you don't have that key yet; the Worker treats empty as "not set".
# PUBLIC_URL is not a secret: it lives in wrangler.jsonc (vars).

# ---------------------------------------------------------------------------
# Needed now
# ---------------------------------------------------------------------------

# Postgres connection string for all app data (leads, drafts, approvals, events).
# Neon console > your project > Connect > copy the connection string (pooled is fine, keep sslmode=require).
DATABASE_URL=

# Naive (managed agents): runs research/draft sessions and calls our MCP tools.
# Naive dashboard > Settings > API keys (needs a plan with API access).
NAIVE_API_KEY=

# AgentMail: sends to opted-in leads and receives replies. Used by scripts/setup.ts to create the inbox + webhook.
# console.agentmail.to > API Keys.
AGENTMAIL_API_KEY=

# Apify: web and lead data (website crawler for onboarding, Google search, people/company scraper Actors).
# Our MCP tools read_website (full crawl) and search_web call Apify's REST API with it; the Naive agent can also
# call Apify's hosted MCP server with it (scripts/setup.ts stores it in the Naive vault).
# console.apify.com > Settings > API & Integrations > Personal API tokens.
APIFY_TOKEN=

# HubSpot CRM sync: import contacts/companies, push leads, notes and lead status back (README "CRM sync").
# HubSpot > Settings > Integrations > Private Apps > Create > Scopes: crm.objects.contacts.read + .write,
# crm.objects.companies.read + .write, crm.schemas.contacts.write + crm.schemas.companies.write > Access token.
HUBSPOT_ACCESS_TOKEN=

# Notion CRM sync (a "Crusonia leads" database). Not the Notion connection Claude Code uses.
# notion.so/profile/integrations > New internal integration > Internal Integration Secret,
# then share a parent page with the integration (see NOTION_PARENT_PAGE_ID below).
NOTION_API_TOKEN=

# Clerk user auth (sign-up/login). Server verifies sessions with the secret key; the publishable key goes to the frontend.
# dashboard.clerk.com > your application > Configure > API keys.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# /api/* accepts Clerk session tokens (Authorization: Bearer <token>). Optional but recommended: the PEM public key
# makes verification networkless (dashboard > API keys > Show JWT public key > PEM). Without it the JWKS is fetched
# with CLERK_SECRET_KEY. Paste the PEM on one line with \n between lines, or in double quotes.
CLERK_JWT_KEY=
# Comma-separated frontend origins allowed to mint tokens (the `azp` claim). Production: https://crusonia.dev,https://www.crusonia.dev.
CLERK_AUTHORIZED_PARTIES=

# ---------------------------------------------------------------------------
# Workspaces (README: Workspaces)
# ---------------------------------------------------------------------------
# The Clerk user id (user_...) of the instance owner: always the owner workspace, which holds every row from before
# workspaces and is what MCP_TOKEN uses. Also a platform admin. `bun run migrate` reads it too (it never goes in a file
# in the repo).
OWNER_CLERK_USER_ID=
# Anyone who signs up gets their own workspace. "false" closes sign-up (existing members and invited teammates still get in).
# SIGNUPS_OPEN=true
# Clerk user ids refused with 403 (comma list). Stops Autopilot in the workspaces they made, too.
# BLOCKED_USER_IDS=
# Clerk user ids the owner approved: they can sign up while SIGNUPS_OPEN=false.
# SIGNUP_ALLOWED_USER_IDS=
# Teammate invite emails over the last 24 hours (they go out from AGENTMAIL_INBOX_ID, from any workspace), and how many
# workspaces one person may make.
# INVITES_PER_WORKSPACE_PER_DAY=10
# INVITES_PER_USER_PER_DAY=15
# INVITES_PER_EMAIL_PER_DAY=3
# INVITES_PER_INSTANCE_PER_DAY=50
# The instance as a whole (README: Opening sign-ups): Naive + Apify spend of every workspace but the owner's per rolling
# 24 hours, in USD. At the cap, new paid starts answer 429 instance_busy.
# INSTANCE_DAILY_CAP_USD=25
# MAX_WORKSPACES_PER_USER=5
# Workspaces besides the owner's that may send email (comma list of workspace ids). Every workspace sends from
# AGENTMAIL_INBOX_ID, the owner's inbox, so the others can draft but not send until they are listed here.
# SEND_WORKSPACE_IDS=
# Clerk user ids of the instance's operators: read-only, audited access to every workspace's agent runs and traces
# (/api/admin). The owner is always one.
# PLATFORM_ADMIN_USER_IDS=
# Autopilot (README: Autopilot). Which workspaces run by themselves: a comma list of ids, or * for all. Unset: none.
# AUTOPILOT_WORKSPACES=
# The Operator agent; `bun run setup --agent` creates it and prints its id.
# NAIVE_OPERATOR_AGENT_ID=
# AUTOPILOT_EVERY_HOURS=6
# AUTOPILOT_WEEKLY_CAP_USD=5
# AUTOPILOT_OPERATOR_EVERY_HOURS=6
# AUTOPILOT_OPERATOR_MIN_GAP_MINUTES=20
# AUTOPILOT_OPERATOR_MAX_PER_DAY=8
# AUTOPILOT_AGENT_STARTS_PER_HOUR=10
# Naive spend cap per workspace over the last 24 hours, in USD (on top of each agent's Naive budget).
# WORKSPACE_DAILY_CAP_USD=5
# For every workspace but the owner's: paid runs started per hour, runs active at once, Apify-backed web reads per hour.
# PAID_STARTS_PER_HOUR=20
# MAX_ACTIVE_SESSIONS=5
# WEB_CALLS_PER_HOUR=60

# ---------------------------------------------------------------------------
# Generated by us
# ---------------------------------------------------------------------------

# Bearer token for our MCP endpoint (${PUBLIC_URL}/mcp): Naive (setup.ts stores it in the Naive vault) and your own
# Claude Code / Cursor / Codex (see "Connect your agent" in README.md). Without it, /mcp answers 503.
# Generate locally: openssl rand -hex 32   (paste the output here; don't share it)
MCP_TOKEN=

# ---------------------------------------------------------------------------
# Written by scripts/setup.ts (run `bun run setup --write`, or paste what it prints)
# ---------------------------------------------------------------------------

# Verifies Naive webhook signatures on /webhooks/naive (whsec_..., shown once by Naive).
NAIVE_WEBHOOK_SECRET=
# Naive vault holding the MCP_TOKEN credential (vlt_...).
NAIVE_VAULT_ID=
# AgentMail inbox we send from and receive replies on.
AGENTMAIL_INBOX_ID=
# Verifies AgentMail (Svix) webhook signatures on /webhooks/agentmail (whsec_...).
AGENTMAIL_WEBHOOK_SECRET=
# Naive agent that runs research sessions (POST /api/workflows/research). setup.ts creates it (system prompt:
# playbooks/research.md) and updates it in place on re-runs; `bun run setup --agent` re-applies only the agent.
NAIVE_AGENT_ID=
# The "Crusonia leads" Notion database CRM sync writes to. `bun run setup --crm --write` creates it under
# NOTION_PARENT_PAGE_ID and writes its id here.
NOTION_LEADS_DATABASE_ID=

# Setup only (`bun run setup --crm`): the Notion page shared with the integration that will hold the
# "Crusonia leads" database (the 32-character id at the end of the page's URL). Only setup reads it.
# NOTION_PARENT_PAGE_ID=
# Optional, setup only: AgentMail username for the inbox (default "crusonia" -> crusonia@agentmail.to).
# AGENTMAIL_USERNAME=
# Optional, setup only: the Naive agent's model and spend limits (micro-USD: 1000000 = $1). Defaults shown.
# The model is pinned (vetta/auto switched models mid-session, and each switch re-wrote the prompt cache); any id from
# GET /v1/models works. The harness (Naive's default when unset) is fixed when the agent is created.
# NAIVE_AGENT_MODEL=openai/gpt-6.1-terra
# NAIVE_AGENT_BUDGET_PERIOD=day
# NAIVE_AGENT_BUDGET_CAP_MICRO_USD=5000000
# NAIVE_AGENT_MAX_TASK_MICRO_USD=1000000
# NAIVE_AGENT_HARNESS=

# ---------------------------------------------------------------------------
# Billing (Stripe): see "Billing (Stripe)" in README.md. Optional: without a key, billing answers 503 and
# nothing is blocked.
# ---------------------------------------------------------------------------

# Crusonia's own Stripe account (never one shared with another product). Test mode first: sk_test_... or a
# restricted rk_test_... key. Stripe Dashboard > Developers > API keys. `bun run setup --stripe` refuses a live key
# unless you pass --live.
STRIPE_SECRET_KEY=
# Verifies Stripe webhook signatures on /webhooks/stripe (whsec_...). `bun run setup --stripe` writes it to
# .dev.vars.stripe.test (or .live) instead of printing it; upload with `bunx wrangler secret bulk .dev.vars.stripe.test`
# and copy the line here for `wrangler dev`.
STRIPE_WEBHOOK_SECRET=
# Paid work (onboarding propose, leads/find, research) answers 402 insufficient_credits when the workspace's balance
# is <= 0: always for every workspace but the owner's. "true" turns it on for the owner workspace too (off by default
# so the owner's own use never blocks); MCP_TOKEN always bypasses it.
# BILLING_ENFORCED=false
# Free-sample credits granted once per new workspace (about 5 leads). 0 turns it off.
# BILLING_FREE_CREDITS=300
# "true" only on a test instance: Checkout then accepts a Stripe test key. Anywhere else a test key answers 503
# payments_not_live, because a test card must not buy credits that spend real money.
# BILLING_TEST_MODE_OK=

# ---------------------------------------------------------------------------
# Optional policy (defaults shown)
# ---------------------------------------------------------------------------

# Naive tool calls that run without asking the owner: comma list, `*` suffix wildcards, `none` to ask for everything.
# Anything else becomes a 'tool' approval. Never auto-allowed while paused.
# Apify is limited to the single-page reader and the read-only get-* tools: Actor runs reach the owner as approvals.
# AUTO_CONFIRM_TOOLS=crusonia.get_lead,crusonia.save_research,...  (default: see DEFAULT_AUTO_CONFIRM_TOOLS in src/services/policy.ts;
# list_* tools and web_fetch ask the owner)
# Hard cap in USD on every Apify Actor run Crusonia starts (maxTotalChargeUsd; search_web, read_website). Runs are
# metered into credits at the usage markup either way.
# APIFY_MAX_CHARGE_USD=0.25
# Days to keep each agent session's full event trace (GET /api/workflows/runs/:id/trace).
# TRACE_RETENTION_DAYS=180
# Hours before a send approval (an email draft, from the MCP create_draft tool or the REST API) expires: 7 days.
# SEND_APPROVAL_TTL_HOURS=168
# Minutes before an agent tool or ask_operator question approval expires. The Naive session waits meanwhile; an
# expired tool call is denied to the agent.
# TOOL_APPROVAL_TTL_MINUTES=60
# Weekly budget in USD, shown next to the week's spend (credits charged) on the dashboard (display only, nothing is blocked).
# WEEKLY_BUDGET_USD=

# ---------------------------------------------------------------------------
# CRM sync (README "CRM sync"). Off by default: nothing is written to HubSpot or Notion until a switch is true.
# ---------------------------------------------------------------------------

# Push leads, notes and lead status to HubSpot / leads to the Notion database. The HubSpot import
# (POST /api/integrations/hubspot/import) only reads HubSpot and works without the switch.
# HUBSPOT_SYNC_ENABLED=false
# NOTION_SYNC_ENABLED=false
# Which leads sync: qualified (opted in, qualified, in the send flow, or from HubSpot and scored) or all.
# HUBSPOT_SYNC_SCOPE=qualified
# NOTION_SYNC_SCOPE=qualified
# HubSpot import consent. Unset (the default) = imported contacts get NO consent and are never emailed. Set it to the
# contact property that records an email opt-in; HUBSPOT_CONSENT_VALUES lists the values that count as yes
# (comma list, case-insensitive; default yes, true, 1, opted_in, subscribed, ...). hs_email_optout=true always wins.
# HUBSPOT_CONSENT_PROPERTY=
# HUBSPOT_CONSENT_VALUES=
# Leads synced per target per cron run. Keep it small on the Workers Free plan (50 subrequests per invocation).
# CRM_SYNC_BATCH_SIZE=5

# ---------------------------------------------------------------------------
# iMessage approvals (Photon): see "iMessage approvals (Photon)" in README.md. Off by default.
# ---------------------------------------------------------------------------

# "true" turns on new notices: new approvals are queued for the bridge to text the owner. Off stops new notices only; a
# tapback on a notice already delivered is still applied (stop the bridge to stop that).
# IMESSAGE_ENABLED=false
# Shared with the bridge: signs its calls to /webhooks/photon and /webhooks/photon/poll. Generate once and give the
# same value to the bridge: openssl rand -hex 32
BRIDGE_SECRET=
# Notices texted per 10 minutes before the rest collapse into one "+N more approvals waiting" text.
# IMESSAGE_NOTICE_CAP=6
# "true" also texts approvals that belong to integration-test fixtures (it_* sources, example domains). Keep it off on
# any Worker that shares a database with test suites.
# IMESSAGE_INCLUDE_TEST_DATA=false
# Optional: the owner's phone in E.164 (e.g. +14155550123). When set, /webhooks/photon also refuses commands from any
# other sender (the bridge already filters).
OWNER_PHONE=
# The Photon credentials (SPECTRUM_PROJECT_ID / SPECTRUM_PROJECT_SECRET) belong on the bridge only (bridge/.env.example),
# never on the Worker.

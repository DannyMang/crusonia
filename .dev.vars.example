# Crusonia secrets. Copy to .dev.vars (gitignored), fill in, then upload to the Worker:
#   cp .dev.vars.example .dev.vars
#   bun run secrets            # = wrangler secret bulk .dev.vars
# Never commit .dev.vars, paste values into chat, or pass them as CLI arguments.
# Leave a line empty if you don't have that key yet; the Worker treats empty as "not set".
# PUBLIC_URL is not a secret: it lives in wrangler.jsonc (vars).

# ---------------------------------------------------------------------------
# Needed now
# ---------------------------------------------------------------------------

# Postgres connection string for all app data (leads, drafts, approvals, events).
# Neon console > your project > Connect > copy the connection string (pooled is fine, keep sslmode=require).
DATABASE_URL=

# Naive (managed agents): runs research/draft sessions and calls our MCP tools.
# Naive dashboard > Settings > API keys (needs a plan with API access).
NAIVE_API_KEY=

# AgentMail: sends to opted-in leads and receives replies. Used by scripts/setup.ts to create the inbox + webhook.
# console.agentmail.to > API Keys.
AGENTMAIL_API_KEY=

# Apify: web and lead data (website crawler for onboarding, Google search, people/company scraper Actors).
# Our MCP tools read_website (full crawl) and search_web call Apify's REST API with it; the Naive agent can also
# call Apify's hosted MCP server with it (scripts/setup.ts stores it in the Naive vault).
# console.apify.com > Settings > API & Integrations > Personal API tokens.
APIFY_TOKEN=

# HubSpot CRM sync: import contacts/companies, push leads, notes and lead status back (README "CRM sync").
# HubSpot > Settings > Integrations > Private Apps > Create > Scopes: crm.objects.contacts.read + .write,
# crm.objects.companies.read + .write, crm.schemas.contacts.write + crm.schemas.companies.write > Access token.
HUBSPOT_ACCESS_TOKEN=

# Notion CRM sync (a "Crusonia leads" database). Not the Notion connection Claude Code uses.
# notion.so/profile/integrations > New internal integration > Internal Integration Secret,
# then share a parent page with the integration (see NOTION_PARENT_PAGE_ID below).
NOTION_API_TOKEN=

# Clerk user auth (sign-up/login). Server verifies sessions with the secret key; the publishable key goes to the frontend.
# dashboard.clerk.com > your application > Configure > API keys.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# /api/* accepts Clerk session tokens (Authorization: Bearer <token>). Optional but recommended: the PEM public key
# makes verification networkless (dashboard > API keys > Show JWT public key > PEM). Without it the JWKS is fetched
# with CLERK_SECRET_KEY. Paste the PEM on one line with \n between lines, or in double quotes.
CLERK_JWT_KEY=
# Comma-separated frontend origins allowed to mint tokens (the `azp` claim), e.g. https://app.example.com.
CLERK_AUTHORIZED_PARTIES=
# Comma-separated Clerk user ids (user_...) allowed into /api. Single workspace for now: a verified session from
# anyone else gets 403, so signing up alone never grants access.
CLERK_ALLOWED_USER_IDS=

# ---------------------------------------------------------------------------
# Generated by us
# ---------------------------------------------------------------------------

# Bearer token for our MCP endpoint (${PUBLIC_URL}/mcp): Naive (setup.ts stores it in the Naive vault) and your own
# Claude Code / Cursor / Codex (see "Connect your agent" in README.md). Without it, /mcp answers 503.
# Generate locally: openssl rand -hex 32   (paste the output here; don't share it)
MCP_TOKEN=

# ---------------------------------------------------------------------------
# Written by scripts/setup.ts (run `bun run setup --write`, or paste what it prints)
# ---------------------------------------------------------------------------

# Verifies Naive webhook signatures on /webhooks/naive (whsec_..., shown once by Naive).
NAIVE_WEBHOOK_SECRET=
# Naive vault holding the MCP_TOKEN credential (vlt_...).
NAIVE_VAULT_ID=
# AgentMail inbox we send from and receive replies on.
AGENTMAIL_INBOX_ID=
# Verifies AgentMail (Svix) webhook signatures on /webhooks/agentmail (whsec_...).
AGENTMAIL_WEBHOOK_SECRET=
# Naive agent that runs research sessions (POST /api/workflows/research). setup.ts creates it (system prompt:
# playbooks/research.md) and updates it in place on re-runs; `bun run setup --agent` re-applies only the agent.
NAIVE_AGENT_ID=
# The "Crusonia leads" Notion database CRM sync writes to. `bun run setup --crm --write` creates it under
# NOTION_PARENT_PAGE_ID and writes its id here.
NOTION_LEADS_DATABASE_ID=

# Setup only (`bun run setup --crm`): the Notion page shared with the integration that will hold the
# "Crusonia leads" database (the 32-character id at the end of the page's URL). Only setup reads it.
# NOTION_PARENT_PAGE_ID=
# Optional, setup only: AgentMail username for the inbox (default "crusonia" -> crusonia@agentmail.to).
# AGENTMAIL_USERNAME=
# Optional, setup only: the Naive agent's model and spend limits (micro-USD: 1000000 = $1). Defaults shown.
# The harness (Naive's default when unset) is fixed when the agent is created.
# NAIVE_AGENT_MODEL=vetta/auto
# NAIVE_AGENT_BUDGET_PERIOD=day
# NAIVE_AGENT_BUDGET_CAP_MICRO_USD=5000000
# NAIVE_AGENT_MAX_TASK_MICRO_USD=1000000
# NAIVE_AGENT_HARNESS=

# ---------------------------------------------------------------------------
# Optional policy (defaults shown)
# ---------------------------------------------------------------------------

# Naive tool calls that run without asking the owner: comma list, `*` suffix wildcards, `none` to ask for everything.
# Anything else becomes a 'tool' approval. Never auto-allowed while paused.
# AUTO_CONFIRM_TOOLS=crusonia.*,apify.*,web_search,web_fetch
# Hours before a send approval (an email draft, from the MCP create_draft tool or the REST API) expires: 7 days.
# SEND_APPROVAL_TTL_HOURS=168
# Minutes before an agent tool or ask_operator question approval expires. The Naive session waits meanwhile; an
# expired tool call is denied to the agent.
# TOOL_APPROVAL_TTL_MINUTES=60
# Weekly Naive spend budget in USD, shown next to the week's spend on the dashboard (display only, nothing is blocked).
# WEEKLY_BUDGET_USD=

# ---------------------------------------------------------------------------
# CRM sync (README "CRM sync"). Off by default: nothing is written to HubSpot or Notion until a switch is true.
# ---------------------------------------------------------------------------

# Push leads, notes and lead status to HubSpot / leads to the Notion database. The HubSpot import
# (POST /api/integrations/hubspot/import) only reads HubSpot and works without the switch.
# HUBSPOT_SYNC_ENABLED=false
# NOTION_SYNC_ENABLED=false
# Which leads sync: qualified (opted in, qualified, in the send flow, or from HubSpot and scored) or all.
# HUBSPOT_SYNC_SCOPE=qualified
# NOTION_SYNC_SCOPE=qualified
# HubSpot import consent. Unset (the default) = imported contacts get NO consent and are never emailed. Set it to the
# contact property that records an email opt-in; HUBSPOT_CONSENT_VALUES lists the values that count as yes
# (comma list, case-insensitive; default yes, true, 1, opted_in, subscribed, ...). hs_email_optout=true always wins.
# HUBSPOT_CONSENT_PROPERTY=
# HUBSPOT_CONSENT_VALUES=
# Leads synced per target per cron run. Keep it small on the Workers Free plan (50 subrequests per invocation).
# CRM_SYNC_BATCH_SIZE=5

# ---------------------------------------------------------------------------
# Later: Photon iMessage approvals (Photon Stable)
# ---------------------------------------------------------------------------

# Photon Spectrum project credentials for sending/receiving iMessages.
# photon.codes dashboard > your project (Stable) > project ID and secret.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Owner's phone number in E.164 (e.g. +14155550123): where approval requests are sent.
OWNER_PHONE=

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crusonia",
  "main": "src/index.ts",
  // Matches the workerd bundled with wrangler 4.158 so `wrangler dev` runs the same runtime as prod.
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    // Every minute: the scheduled handler will drive due work (expired approvals, stalled sessions).
    "crons": ["* * * * *"]
  },
  // The dashboard SPA (web/, `bun run build:web`) is served as static assets; files that exist never run the
  // Worker. These paths run the Worker first (API, MCP, webhooks, health). Any other path without a file goes
  // to the Worker too ("none" below, not "single-page-application"): it answers 404 for a missing /assets/* or
  // /media/* file and index.html for client-side routes (/app/*, /onboarding/*, /sign-in). See src/index.ts.
  // "/" is a file, but it runs the Worker too: a www or old-hostname visitor must get the redirect, not the app.
  // Cache headers for the files are in web/public/_headers.
  "assets": {
    "directory": "./web/dist",
    // src/index.ts serves index.html for client-side routes through this binding.
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/api/*", "/mcp", "/mcp/*", "/webhooks/*", "/health"]
  },
  // Version URLs (and aliased ones like app-crusonia.<subdomain>.workers.dev from
  // `bun run deploy:preview`) stay on. They run with production's secrets and database.
  "preview_urls": false,
  // Production's hostnames. On deploy Cloudflare creates their DNS records and certificates.
  "routes": [
    { "pattern": "crusonia.dev", "custom_domain": true },
    { "pattern": "www.crusonia.dev", "custom_domain": true }
  ],
  // With routes, Wrangler turns the workers.dev URL off unless this says otherwise. LEGACY_HOSTS below still needs it.
  "workers_dev": true,
  "vars": {
    // Public base URL of this Worker. Webhooks and the MCP endpoint are registered under it.
    "PUBLIC_URL": "https://crusonia.dev",
    // Production's old hostname: machines keep working there (/api, /mcp, /webhooks, /health) and browser pages redirect
    // to PUBLIC_URL (src/lib/canonical-host.ts). Staging has none.
    "LEGACY_HOSTS": "crusonia.veri-web.workers.dev"
  },
  // Per-IP limits (src/lib/rate-limit.ts), per minute and per Cloudflare location. No database, so a flood costs no queries.
  // Bindings aren't inherited by env.staging, which has its own namespaces below.
  "ratelimits": [
    { "name": "RL_ANON", "namespace_id": "2001", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_PAID", "namespace_id": "2002", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_SIGNUP", "namespace_id": "2003", "simple": { "limit": 60, "period": 60 } }
  ],
  "env": {
    // Staging: a separate Worker (crusonia-staging) with its own secrets, its own database (a Neon dev branch)
    // and its own provider webhooks, Naive agent and MCP URL. Deploy with `bun run deploy:staging`; set it up
    // with `bun run setup --env staging` (reads and writes .dev.vars.staging). See README "Staging".
    // vars are not inherited from the top level, so PUBLIC_URL is repeated here.
    "staging": {
      "name": "crusonia-staging",
      // routes are inherited: without this, deploying staging would take crusonia.dev away from production.
      "routes": [],
      "vars": {
        "PUBLIC_URL": "https://crusonia-staging.veri-web.workers.dev",
        "LEGACY_HOSTS": "",
        // Staging's Stripe key is a test key, and staging is the test instance: Checkout works here and nowhere else.
        "BILLING_TEST_MODE_OK": "true"
      },
      "ratelimits": [
        { "name": "RL_ANON", "namespace_id": "2011", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_PAID", "namespace_id": "2012", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_SIGNUP", "namespace_id": "2013", "simple": { "limit": 60, "period": 60 } }
      ]
    }
  }
  // Secrets (DATABASE_URL, provider keys, ...) are not declared here: see .dev.vars.example.
  // We deliberately do not use `secrets.required`, because it makes `wrangler deploy` fail until
  // every secret is uploaded, and we deploy the health endpoint before keys exist.
}
